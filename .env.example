# --- Required ---

# Local dev: SQLite. Vercel: Postgres (set by Neon integration).
DATABASE_URL="file:./dev.db"

# JWT signing secret. Use a long random string in production.
# Generate one with: openssl rand -base64 48
JWT_SECRET="change-me-to-a-long-random-string-in-production"

# OpenRouter API key. Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY="sk-or-v1-..."

# OpenRouter model. Cheap + fast default. Override for higher quality.
# https://openrouter.ai/models
OPENROUTER_MODEL="anthropic/claude-3.5-haiku"

# Public site URL (used in metadata, share links, etc.)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Optional (payments) ---

# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""
# STRIPE_PRICE_A=""
# STRIPE_PRICE_B=""
# STRIPE_PRICE_C=""
# STRIPE_PRICE_D=""

# --- Optional (emails) ---

# Resend transactional email. Get an API key at https://resend.com/api-keys
# Without this, signups and payment events won't send email (but signup still works).
# RESEND_API_KEY="re_..."

# Verified sender. Defaults to onboarding@resend.dev (no domain needed for testing).
# Set to e.g. "omicron <hello@omicron.ink>" once the domain is verified in Resend.
# RESEND_FROM_EMAIL="onboarding@resend.dev"

# --- Optional (cron) ---

# Shared secret for Vercel Cron to call internal cron routes.
# Generate with: openssl rand -base64 32
# CRON_SECRET=""
