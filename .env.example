# --- Required ---

# Local dev: SQLite. Vercel: Postgres (set by Vercel Postgres integration).
DATABASE_URL="file:./dev.db"

# JWT signing secret. Use a long random string in production.
# Generate one with: openssl rand -base64 48
JWT_SECRET="change-me-to-a-long-random-string-in-production"

# OpenRouter API key. Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY="sk-or-v1-..."

# OpenRouter model. Cheap + fast default. Override for higher quality.
# https://openrouter.ai/models
OPENROUTER_MODEL="anthropic/claude-3.5-haiku"

# Public site URL (used in metadata, share links, etc.)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Optional (payments) ---

# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""
# STRIPE_PRICE_A=""
# STRIPE_PRICE_B=""
# STRIPE_PRICE_C=""
# STRIPE_PRICE_D=""
